# Public site origin used for canonicals, sitemap, and share images.
# Set this to your real domain once DNS is connected (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://squeakysolutions.au

# Ops desk. Both must be long, unique, and DIFFERENT from each other.
# ADMIN_PASSWORD: at least 16 characters (passphrase recommended).
# ADMIN_SECRET: at least 32 random characters — used only to sign cookies.
# Generate: openssl rand -base64 48
ADMIN_PASSWORD=
ADMIN_SECRET=

# SQLite file path. Use a persistent volume path in production
# (Railway/Fly disk, or a bind-mounted folder). Never rely on ephemeral
# serverless disk (e.g. default Vercel FS) — bookings will vanish on redeploy.
# DATABASE_PATH=/data/binbus.db

# Desk inbox — Gmail SMTP. Use an App Password, not your normal password.
# https://myaccount.google.com/apppasswords
# Personal data in booking/inquiry emails is processed by Google.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=you@gmail.com

# Customer SMS confirmation. Twilio trial can only text numbers you verify.
# Mobiles are sent to Twilio (US-linked processor) to deliver confirmations.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

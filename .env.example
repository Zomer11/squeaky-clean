# Public site origin used for canonicals, sitemap, and share images.
# Set this to your real domain once DNS is connected (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://squeakysolutions.au

# Ops desk (/admin). Generate both with:  npm run admin:setup
# ADMIN_PASSWORD_HASH: scrypt hash of the password (the password itself is never stored).
# ADMIN_TOTP_SECRET: authenticator-app 2FA secret. Both are REQUIRED in production.
# Rotating either one signs out every open session.
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
# Local dev only, instead of the hash: a 16+ char plaintext password.
# ADMIN_PASSWORD=

# Optional: only these IPs can even see /admin (comma-separated). Everyone else gets a 404.
# Great if you have a fixed home/office IP; skip it if you sign in from mobile data.
# ADMIN_ALLOWED_IPS=

# Bot check on the booking + contact forms (Cloudflare Turnstile, free, no puzzles for humans).
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile — both keys required.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Flood caps — counted from the database, so rotating IPs doesn't get around them.
# BOOKING_MAX_PER_PHONE_DAY=3
# BOOKING_MAX_PER_HOUR=20
# INQUIRY_MAX_PER_PHONE_DAY=4
# INQUIRY_MAX_PER_HOUR=30

# Header your host sets to the real client IP (used for login rate limits).
# Cloudflare: cf-connecting-ip · Fly: fly-client-ip · Vercel: x-vercel-forwarded-for
# Leave unset to use the right-most X-Forwarded-For hop (fine on Railway/Render).
# TRUSTED_IP_HEADER=

# SQLite file path. Use a persistent volume path in production
# (Railway/Fly disk, or a bind-mounted folder). Never rely on ephemeral
# serverless disk (e.g. default Vercel FS) — bookings will vanish on redeploy.
# DATABASE_PATH=/data/binbus.db

# Desk inbox — Gmail SMTP. Use an App Password, not your normal password.
# https://myaccount.google.com/apppasswords
# Personal data in booking/inquiry emails is processed by Google.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=you@gmail.com

# Customer SMS confirmation. Twilio trial can only text numbers you verify.
# Mobiles are sent to Twilio (US-linked processor) to deliver confirmations.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
